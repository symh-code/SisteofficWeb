# EmailJS — usadas por app/lib/emailjs.ts (@emailjs/browser).
# Deben estar disponibles en el entorno donde se ejecuta `next build`
# (NEXT_PUBLIC_* se inlinean en el bundle del cliente en tiempo de build,
# no son secretos de servidor: no van en wrangler.jsonc ni en .dev.vars).
# Copia este archivo a .env.local y completa los valores reales de tu
# cuenta de EmailJS. Nunca commitees .env.local (ya está en .gitignore).
#
# El plan gratuito de EmailJS solo permite 2 templates, así que
# QUOTE_TEMPLATE_ID se reutiliza tanto para cotizar un producto individual
# como para cotizar el carrito completo (ver app/lib/emailjs.ts).
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_QUOTE_TEMPLATE_ID=
