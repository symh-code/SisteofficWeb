{
  "name": "sisteoffic-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:camod-proyectos": "node scripts/generate-camod-proyectos.mjs",
    "build": "pnpm run generate:camod-proyectos && next build",
    "dev": "pnpm run generate:camod-proyectos && next dev",
    "start": "next start",
    "lint": "eslint",
    "preview": "pnpm run generate:camod-proyectos && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "pnpm run generate:camod-proyectos && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "pnpm run generate:camod-proyectos && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.115.0"
  }
}